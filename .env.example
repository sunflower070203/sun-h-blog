POSTGRES_DB=sunny_blog
POSTGRES_USER=sunny
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgres://sunny:replace-with-a-long-random-password@postgres:5432/sunny_blog
SESSION_SECRET=replace-with-at-least-32-random-characters
COOKIE_SECURE=false
BLOG_PORT=8080
MEDIA_ROOT=/data/media

# 仅在首次创建或重置管理员时使用
ADMIN_EMAIL=sunny@example.com
ADMIN_PASSWORD=replace-with-a-strong-password-at-least-12-chars
